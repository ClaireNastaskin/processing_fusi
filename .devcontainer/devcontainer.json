{
    "name": "Anise Development",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
    "features": {},
    "customizations": {
        "vscode": {
            "extensions": ["ms-python.python", "editorconfig.editorconfig"],
            "settings": {
                "python.testing.pytestArgs": ["tests"],
                "python.testing.unittestEnabled": false,
                "python.testing.pytestEnabled": true,
                "python.defaultInterpreterPath": "/workspaces/dendrology/.venv/bin/python",
                "python.testing.pytestPath": "/workspaces/dendrology/.venv/bin/pytest"
            }
        }
    },
    "forwardPorts": [],
    "mounts": [
        "source=/mnt/fUS_data,target=/workspaces/Anise/fUS_data,type=bind,consistency=cached",
        // "source=${localWorkspaceFolder},target=/workspaces/Anise,type=bind,consistency=cached"
    ],
    "postCreateCommand": [
        "/bin/sh",
        "-c",
        "/bin/sh ./.devcontainer/postCreateCommand.sh"
    ],
    "remoteUser": "vscode"
}